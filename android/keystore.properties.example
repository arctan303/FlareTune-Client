# Copy this template to `android/keystore.properties` (which is git-ignored) for local signed release builds,
# or provide FLARETUNE_RELEASE_STORE_FILE / FLARETUNE_RELEASE_STORE_PASSWORD /
# FLARETUNE_RELEASE_KEY_ALIAS / FLARETUNE_RELEASE_KEY_PASSWORD as environment variables.
storeFile=C:/Users/<you>/.android-keys/flaretune-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=flaretune
keyPassword=REPLACE_WITH_KEY_PASSWORD
